# NeoForge V ROM test
#
# Plays one ADPCM-A sample from the cartridge V ROM. The V ROM is the one
# cartridge function nothing else we have built exercises - see main.c.
#
#   make            build the cartridge zip
#   make gngeo      build and run in GnGeo, AES mode
#   make clean
#
# Requires ngdevkit on PATH (brew install ngdevkit; brew install ngdevkit-gngeo)
# and nothing else. The sample is generated by sample.py; no audio file is
# committed to this repository.
#
# This is deliberately a separate ROM from ../rom. That one is published as
# fixtest-v1 with a results table, and changing what it does would invalidate
# results people may already be collecting. The two Makefiles overlap; they
# are expected to drift, because they test different things.

GAMEROM   := neoforge-vromtest
BUILD     := build
ROM       := $(BUILD)/rom
PYTHON    ?= python3

PKGCONFIG ?= pkg-config
NGCFLAGS  := $(shell $(PKGCONFIG) --cflags ngdevkit)
NGLIBS    := $(shell $(PKGCONFIG) --libs ngdevkit)
SHAREDIR  := $(shell $(PKGCONFIG) --variable=sharedir ngdevkit)
Z80INCDIR := $(shell $(PKGCONFIG) --variable=z80includedir ngdevkit)
Z80LIBDIR := $(shell $(PKGCONFIG) --variable=z80libdir ngdevkit)

GCC        := m68k-neogeo-elf-gcc
OBJCOPY    := m68k-neogeo-elf-objcopy
Z80AS      := z80-neogeo-ihx-sdasz80
Z80LD      := z80-neogeo-ihx-sdldz80
Z80OBJCOPY := z80-neogeo-ihx-sdobjcopy
ROMTOOL    := romtool.py
VROMTOOL   := vromtool.py
GNGEO      ?= ngdevkit-gngeo

CFLAGS := -std=c99 -fomit-frame-pointer -O2 -g

# -aes: the two nullsound variants differ only in the FM and SSG frequency
# tables. ADPCM-A does not use them - its rate is fixed by the YM2610 - so the
# choice does not change what this ROM sounds like. It would the moment
# anything here used FM or SSG. See sound-driver.s.
NULLSOUND ?= $(Z80LIBDIR)/nullsound-aes.lib

# The fix tiles come from the fix-layer test's generator. One font, two ROMs.
TILES := ../rom/tiles.py

GNGEO_DATA ?= $(shell brew --prefix ngdevkit-gngeo 2>/dev/null)/share/ngdevkit-gngeo/gngeo_data.zip

PROM  := $(ROM)/$(GAMEROM)-p1.p1
SROM  := $(ROM)/$(GAMEROM)-s1.s1
MROM  := $(ROM)/$(GAMEROM)-m1.m1
CROM1 := $(ROM)/$(GAMEROM)-c1.c1
CROM2 := $(ROM)/$(GAMEROM)-c2.c2
VROM  := $(ROM)/$(GAMEROM)-v1.v1
CART  := $(ROM)/$(GAMEROM).zip

P_SIZE := 1048576
S_SIZE := 131072
M_SIZE := 131072
C_SIZE := 2097152
V_SIZE := 524288

pad = $(PYTHON) -c 'import sys;open(sys.argv[1],"ab").truncate(int(sys.argv[2]))' $(1) $(2)

.PHONY: all gngeo clean distclean
all: $(CART)

$(ROM):
	@mkdir -p $(ROM)

# --- the sample -------------------------------------------------------------
# Synthesised rather than borrowed. See sample.py.
assets/chirp.wav: sample.py
	@mkdir -p assets
	$(PYTHON) sample.py $@

# vromtool runs twice, because --roms and --asm are mutually exclusive modes:
# once to pack the V ROM, once to emit the offsets the Z80 driver needs. The
# -o pattern must contain a literal X, which vromtool replaces with the ROM
# number.
$(VROM): samples.yaml assets/chirp.wav | $(ROM)
	$(VROMTOOL) --roms -s $(V_SIZE) samples.yaml -o "$(ROM)/$(GAMEROM)-vX.vX"
	$(call pad,$@,$(V_SIZE))

$(BUILD)/samples.inc: samples.yaml assets/chirp.wav | $(ROM)
	$(VROMTOOL) --asm -s $(V_SIZE) samples.yaml -o "$(ROM)/$(GAMEROM)-vX.vX" -m $@

# --- fix tiles --------------------------------------------------------------
# Only the S ROM is wanted here. tiles.py writes C ROMs only when given the
# extra arguments, so this ROM's C ROMs stay empty - it draws no sprites.
$(BUILD)/neoforge.fix: $(TILES) | $(ROM)
	$(PYTHON) $(TILES) $@

$(SROM): $(BUILD)/neoforge.fix
	cp $< $@
	$(call pad,$@,$(S_SIZE))

# --- 68k program -------------------------------------------------------------
$(BUILD)/main.o: main.c | $(ROM)
	$(GCC) $(NGCFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD)/rom.elf: $(BUILD)/main.o
	$(GCC) -o $@ $< $(NGLIBS)

$(PROM): $(BUILD)/rom.elf
	$(OBJCOPY) -O binary -S -R .text2 --gap-fill 0xff --pad-to $(P_SIZE) $< $@
	dd if=$@ of=$@ conv=notrunc,swab status=none

# --- Z80 program -------------------------------------------------------------
# -I$(BUILD) is how sound-driver.s finds the generated samples.inc.
# -b DATA=0xf800 is where nullsound expects its state trackers; not optional.
$(BUILD)/sound-driver.rel: sound-driver.s $(BUILD)/samples.inc
	$(Z80AS) -g -l -p -u -I$(Z80INCDIR)/nullsound -I$(BUILD) -o $@ $<

$(BUILD)/sound-driver.ihx: $(BUILD)/sound-driver.rel
	@test -f "$(NULLSOUND)" || { \
	  echo "ERROR: nullsound-aes.lib not found at $(NULLSOUND)"; \
	  echo "       it ships with ngdevkit - check 'pkg-config --variable=z80libdir ngdevkit'"; \
	  exit 1; }
	$(Z80LD) -b DATA=0xf800 -m -w -i $@ $(NULLSOUND) $<

$(MROM): $(BUILD)/sound-driver.ihx
	$(Z80OBJCOPY) -I ihex -O binary $< $@ --pad-to $(M_SIZE)

# --- C ROMs: empty. This ROM draws no sprites. ------------------------------
$(CROM1) $(CROM2): | $(ROM)
	: > $@
	$(call pad,$@,$(C_SIZE))

# --- assemble ----------------------------------------------------------------
$(CART): $(PROM) $(SROM) $(MROM) $(CROM1) $(CROM2) $(VROM)
	$(ROMTOOL) -b cartridge -f zip -p $(PROM) -c $(CROM1) $(CROM2) -v $(VROM) \
	  -s $(SROM) -m $(MROM) -n $(GAMEROM) -x "zip.comment=" -o $@
	$(ROMTOOL) -b hash -f gngeo -p $(PROM) -c $(CROM1) $(CROM2) -v $(VROM) \
	  -s $(SROM) -m $(MROM) -n $(GAMEROM) -l "NeoForge V ROM test" \
	  -x gngeo.data=$(GNGEO_DATA) -o $(ROM)/gngeo_data.zip
	cp $(SHAREDIR)/aes.zip $(SHAREDIR)/neogeo.zip $(ROM)/
	@echo
	@echo "built $(CART)"

# --system home is AES mode
gngeo: $(CART)
	$(GNGEO) --scale 3 --no-resize --system home -i $(ROM) -d $(ROM)/gngeo_data.zip $(GAMEROM)

clean:
	rm -rf $(BUILD) assets/chirp.wav

distclean: clean
