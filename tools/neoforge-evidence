#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Collect every evidence tag in the repository into one index.

    tools/neoforge-evidence                 # write docs/evidence-index.md
    tools/neoforge-evidence --stdout        # print instead
    tools/neoforge-evidence --check         # exit 1 if the committed index is stale

NeoForge tags claims with their standard of evidence - [VERIFIED: source],
[MEASURED: date], [ANECDOTAL], [UNVERIFIED] - and applies the convention well
in each file and nowhere centrally. The result is that we know which of our
claims are soft only while we are reading the file that carries them. The
C1/C2 byte-order note in sim/harness/mkdata.py says "revisit before trusting
sprite output" and nothing outside that file knows it exists.

This walks the tree and prints them all, weakest first, because the weak ones
are the ones with work attached.

GENERATED OUTPUT. Do not hand-edit docs/evidence-index.md - fix the tag at its
source and re-run, or the index and the claims drift apart, which is precisely
the failure this tool exists to prevent.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from collections import defaultdict

TAG = re.compile(r"\[(VERIFIED|MEASURED|ANECDOTAL|UNVERIFIED)(:\s*[^\]]*)?\]")

# Weakest first: these are the ones with work attached.
ORDER = ["UNVERIFIED", "ANECDOTAL", "MEASURED", "VERIFIED"]

HEADING = {
    "UNVERIFIED": ("Unverified", "Claims we have not checked. Each one is a"
                   " question with nobody assigned to it."),
    "ANECDOTAL": ("Anecdotal", "Reported by somebody, believed by nobody in"
                  " particular. Useful as a lead, not as a basis."),
    "MEASURED": ("Measured", "We ran it, built it, or read it off a part."
                 " Reproducible by someone who repeats what we did."),
    "VERIFIED": ("Verified", "Traced to a source that is not us."),
}

SKIP_DIRS = {".git", ".reference", "build", "node_modules", "__pycache__"}

# These files *define* the convention rather than making claims under it.
# Indexing "[UNVERIFIED] - inference not yet confirmed" as an unverified claim
# is a category error, and it buries the real ones.
SKIP_FILES = {"claude.md", "contributing.md"}

OUT = "docs/evidence-index.md"


def tracked_files(root):
    """Prefer git's idea of the tree; fall back to a walk."""
    try:
        out = subprocess.run(["git", "--no-optional-locks", "ls-files", "-z"],
                             cwd=root, capture_output=True, check=True)
        names = [n for n in out.stdout.decode().split("\0") if n]
    except Exception:
        names = []
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            for f in filenames:
                names.append(os.path.relpath(os.path.join(dirpath, f), root))
    return [n for n in names
            if not any(part in SKIP_DIRS for part in n.split(os.sep))
            and n != OUT and n not in SKIP_FILES]


def claim_for(lines, i):
    """The text the tag is attached to.

    A tag almost always closes a claim rather than opening one, so walk back
    to the start of the paragraph (or comment block) and use that, minus the
    tags themselves.
    """
    start = i
    while start > 0:
        prev = lines[start - 1].strip()
        if not prev or prev.startswith(("#", "|", "---", "===", "```")):
            break
        if len(lines[i].strip()) and prev.startswith(("- ", "* ", "1.", "2.")):
            break
        start -= 1
    text = " ".join(lines[start:i + 1])
    text = TAG.sub("", text)
    text = re.sub(r"`\s*`", "", text)          # backticks left around a tag
    text = re.sub(r"\*\*\s*\*\*", "", text)      # emphasis left around a tag
    text = re.sub(r"^[\s>*#|-]+", "", text)
    text = re.sub(r"\s+", " ", text).strip()
    text = text.strip("`* ")
    return text


def collect(root):
    found = defaultdict(list)
    for name in tracked_files(root):
        path = os.path.join(root, name)
        try:
            with open(path, encoding="utf-8") as f:
                lines = f.read().split("\n")
        except (UnicodeDecodeError, IsADirectoryError, FileNotFoundError):
            continue
        for i, line in enumerate(lines):
            for m in TAG.finditer(line):
                kind = m.group(1)
                source = (m.group(2) or "").lstrip(": ").strip()
                found[kind].append({
                    "file": name,
                    "line": i + 1,
                    "source": source,
                    "claim": claim_for(lines, i),
                })
    return found


def render(found):
    total = sum(len(v) for v in found.values())
    out = []
    w = out.append
    w("# Evidence index")
    w("")
    w("**Generated by `tools/neoforge-evidence`. Do not hand-edit.**")
    w("Fix the tag where it is written and re-run, or this file and the claims")
    w("it indexes drift apart - which is the failure it exists to prevent.")
    w("")
    w("NeoForge tags every claim with its standard of evidence. The convention")
    w("is applied carefully in each file and, until this index existed, nowhere")
    w("centrally - so a soft claim was visible only to whoever happened to read")
    w("the file carrying it. Weakest first, because those have work attached.")
    w("")
    w("| Standard | Count |")
    w("|---|---|")
    for kind in ORDER:
        w(f"| {HEADING[kind][0]} | {len(found.get(kind, []))} |")
    w(f"| **Total** | **{total}** |")
    w("")
    for kind in ORDER:
        rows = found.get(kind, [])
        if not rows:
            continue
        title, blurb = HEADING[kind]
        w("---")
        w("")
        w(f"## {title} — {len(rows)}")
        w("")
        w(blurb)
        w("")
        by_file = defaultdict(list)
        for r in rows:
            by_file[r["file"]].append(r)
        for fname in sorted(by_file):
            w(f"### `{fname}`")
            w("")
            for r in sorted(by_file[fname], key=lambda r: r["line"]):
                claim = r["claim"] or "(no adjacent text)"
                if len(claim) > 400:
                    cut = claim[:400].rsplit(" ", 1)[0]
                    claim = cut + " ..."
                src = f" — *{r['source']}*" if r["source"] else ""
                w(f"- **L{r['line']}**{src}  ")
                w(f"  {claim}")
            w("")
    return "\n".join(out).rstrip() + "\n"


def main():
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    args = sys.argv[1:]
    text = render(collect(root))
    path = os.path.join(root, OUT)

    if "--stdout" in args:
        sys.stdout.write(text)
        return 0
    if "--check" in args:
        try:
            with open(path, encoding="utf-8") as f:
                current = f.read()
        except FileNotFoundError:
            print(f"evidence: {OUT} does not exist. Run tools/neoforge-evidence.")
            return 1
        if current != text:
            print(f"evidence: {OUT} is stale. Run tools/neoforge-evidence.")
            return 1
        print(f"evidence: {OUT} is up to date.")
        return 0

    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    found = collect(root)
    print(f"wrote {OUT}")
    for kind in ORDER:
        print(f"  {kind:<12} {len(found.get(kind, [])):>4}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
